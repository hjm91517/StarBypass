# 构建环境变量示例
# 交叉构建不需要这些；真机构建时才用得上。

# Xcode SDK 名称，默认 iphoneos
SB_IOS_SDK=iphoneos

# 最低支持版本，与 Makefile 的 IOS_MIN 对应
SB_IOS_MIN=14.0

# 目标架构，仅支持 arm64
SB_ARCH=arm64

# 卡密配置（对应 00-config.h，也可用 -D 覆盖）
# SB_CFG_MASTER_CARD=hjnb
# SB_CFG_ACCEPT_ANY=1
# SB_CFG_OVERRIDE_FAILURE_TEXT=1

# 签名身份，重签 app 时使用；本机临时签名填 -
SB_CODESIGN_IDENTITY=-
